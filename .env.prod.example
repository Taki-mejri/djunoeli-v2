# Copier en .env.prod sur le VPS puis remplir. NE JAMAIS committer .env.prod.

# --- Base de données (service "db", aucun port hôte) ---
# Mot de passe : caractères URL-safe uniquement (ex. `openssl rand -hex 24`)
DB_USER=djunoeli
DB_PASSWORD=CHANGE_ME
DB_NAME=djunoeli_v2

# --- Ports hôte dédiés ---
API_PORT=8092
WEB_PORT=8093

# --- URLs publiques (IP du VPS) ---
# Doit finir par /api/v1 (baseURL axios du front, injecté au build)
PUBLIC_API_URL=http://TON_IP:8092/api/v1
# Origine(s) autorisée(s) par CORS, séparées par des virgules
CORS_ORIGIN=http://TON_IP:8093

# --- Auth ---
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES=15m
REFRESH_EXPIRES=7d
REFRESH_EXPIRES_DAYS=7
# Démo en HTTP (IP:port) : le cookie refresh ne doit PAS être "Secure", sinon le navigateur le rejette.
# Passer à true dès qu'il y a du HTTPS.
COOKIE_SECURE=false

# --- Métier ---
HUB_LAT=51.5136
HUB_LNG=7.4653
WELCOME_BONUS_EUR=20
PRICE_KM_FLOOR=8
PRICE_KM_CAP=50
EXPRESS_SLA_MINUTES=90
PICKUP_CUTOFF_HOUR=11
OTP_CHANNEL=SIMULATION

# Note : DATABASE_URL, PORT et NODE_ENV sont fixés par docker-compose.prod.yml.
